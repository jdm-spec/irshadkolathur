rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Portfolio projects & works: publicly readable, writable only by owner
    match /projects/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /works/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Skills, services, testimonials: publicly readable, writable only by owner
    match /skills/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /services/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /testimonials/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact messages & inquiries: anyone can submit (create), only owner can read/manage
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    match /inquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
